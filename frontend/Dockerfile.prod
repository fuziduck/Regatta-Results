# SailScore frontend — production image.
# Stage 1: build the React app. REACT_APP_BACKEND_URL is empty so the bundle
# talks to the same origin (/api), which nginx proxies to the backend.
FROM node:20 AS build

WORKDIR /app

COPY package.json ./

RUN npm install --legacy-peer-deps --no-audit --no-fund

COPY . .

ARG REACT_APP_BACKEND_URL=""
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL

RUN npm run build

# Stage 2: serve the static build with nginx + the /api reverse proxy.
FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
