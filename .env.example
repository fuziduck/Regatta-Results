# ── SailScore environment template ──────────────────────────────────────
# Copy to `.env` (gitignored) and fill in real values. NEVER commit real
# secrets. For development you can use throwaway values; for production use
# long random strings and real domains.

# Deployment mode: development | production
# Production refuses to start with weak secrets and disables API docs.
ENV=development

# --- Backend ---
# Random string of at least 32 characters. Production refuses weak values and
# any placeholder still set to REPLACE_WITH_* / change-me-*.
# Generate: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING

# Bootstrap passcode for the single webmaster account (seeded once, never on
# restart). At least 8 characters in production.
WEBMASTER_PASSCODE=REPLACE_WITH_STRONG_PASSCODE

# Access-token lifetime in hours (default 8).
JWT_EXPIRE_HOURS=8

# Per-IP login attempts allowed per minute (default 60).
LOGIN_IP_LIMIT=60

# Comma-separated list of allowed browser origins.
# Development:  http://localhost:3000,http://127.0.0.1:3000
# Production:   https://results.yourclub.org (never "*")
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MongoDB connection (production must include credentials):
#   mongodb://sailscore:<strong-password>@mongodb:27017/regatta?authSource=admin
MONGO_URL=mongodb://mongodb:27017/regatta
DB_NAME=regatta

# --- Frontend (development only; ignored by the production build) ---
# Host-accessible URL the browser uses to reach the API.
REACT_APP_BACKEND_URL=http://127.0.0.1:8000

# --- Password reset email (SMTP) ---
# Development: leave SMTP_HOST empty — the reset token is then returned in
# the API response so the flow works without a mail server.
# Production: required — set SMTP_HOST and APP_BASE_URL or the app refuses
# to start.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Public base URL used to build password-reset links (e.g. https://results.yourclub.org)
APP_BASE_URL=http://127.0.0.1:3000
# Reset-link lifetime in minutes (default 30).
RESET_TOKEN_MINUTES=30

# --- Production MongoDB root credentials (docker-compose.yml, production) ---
MONGO_INITDB_ROOT_USERNAME=REPLACE_WITH_DB_USERNAME
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_DB_PASSWORD
