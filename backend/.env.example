JWT_SECRET=replace-with-a-random-32-character-secret

# Runtime
ENV=development
CORS_ORIGINS=http://localhost:3000
WEBMASTER_PASSCODE=replace-in-development
APP_BASE_URL=http://localhost:3000
PUBLIC_APP_BASE_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:8000/api

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
